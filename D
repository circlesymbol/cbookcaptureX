# Use a highly compatible, secure Ubuntu desktop base image
FROM linuxserver/webtop:ubuntu-mate

# Force the container's built-in web server to use Hugging Face's port
ENV PORT=7860
EXPOSE 7860

# Set up standard system permissions
ENV PUID=1000
ENV PGID=1000
ENV TZ=Etc/UTC

# Hugging Face runs containers as non-root users for safety. 
# We give the system directory open permissions so it doesn't crash on boot.
RUN chmod -R 777 /var /run /abc
