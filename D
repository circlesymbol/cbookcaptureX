# Use an Ubuntu core pre-configured for web routing and strict cloud sandboxes
FROM lscr.io/linuxserver/webtop:ubuntu-openbox

# Point the internal visual layout system to Hugging Face's default port
ENV PORT=7860
EXPOSE 7860

# Redirect the system home directory to a safe, unrestricted temporary folder
ENV HOME=/tmp
WORKDIR /tmp

# Build a safe local configuration folder that does not trigger permission errors
RUN mkdir -p /tmp/config && chmod -R 777 /tmp
